# Minimal notifications in dwm's colors and font. Reload: killall dunst (it restarts on the next notification).
[global]
    font = monospace 10
    origin = top-right
    offset = (8, 36)
    width = (0, 360)
    notification_limit = 4
    padding = 6
    horizontal_padding = 10
    frame_width = 1
    frame_color = "#444444"
    separator_height = 1
    separator_color = frame
    gap_size = 4
    corner_radius = 0
    icon_position = off
    format = "<b>%s</b> %b"
    alignment = left
    ellipsize = end
    show_age_threshold = -1
    show_indicators = no
    mouse_left_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#222222"
    foreground = "#bbbbbb"
    timeout = 3

[urgency_normal]
    background = "#222222"
    foreground = "#bbbbbb"
    timeout = 5

# 3-hour deadline warnings and finished focus timers: stay until clicked.
[urgency_critical]
    background = "#222222"
    foreground = "#eeeeee"
    frame_color = "#eeeeee"
    timeout = 0
