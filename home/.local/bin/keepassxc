#!/bin/sh
# At the desktop-wide DPI KeePassXC's text looks oversized next to its fixed-size icons.
# Give this one app fonts at 5/6 of the desktop DPI (144 -> 120). Does nothing at 96.
dpi=$(xrdb -query 2>/dev/null | awk '/^Xft\.dpi:/{print int($2)}')
[ "${dpi:-0}" -gt 96 ] && export QT_FONT_DPI=$((dpi * 5 / 6))
exec /usr/bin/keepassxc "$@"
