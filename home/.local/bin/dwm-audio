#!/usr/bin/env bash
#
# dwm-audio: volume control and output/input device switching for the dwm
# bar and keybindings (PipeWire via wpctl/pactl).
#
#   dwm-audio vol up|down|mute|micmute|micup|micdown
#   dwm-audio status              one-line summary for the bar, e.g. "VOL 40% HDMI"
#   dwm-audio menu out|in         dmenu picker; sets the default device and
#                                 moves any playing/recording streams onto it
#   dwm-audio list out|in         print the picker entries (marks the default with *)
#   dwm-audio pick out|in LABEL   select a device by its picker label

STEP=5

refresh_bar() {
	local pid
	pid="$(cat "${XDG_RUNTIME_DIR:-/tmp}/dwm-status.pid" 2>/dev/null)" || return 0
	[ -n "$pid" ] && kill -USR1 "$pid" 2>/dev/null
	return 0
}

DMENU=(dmenu -i -l 8 -fn "monospace:size=10"
	-nb "#222222" -nf "#bbbbbb" -sb "#eeeeee" -sf "#000000")

kind_setup() {
	case "$1" in
	out) KIND=sinks; DEFAULT_CMD=get-default-sink; SET_CMD=set-default-sink
	     STREAMS=sink-inputs; MOVE_CMD=move-sink-input; PROMPT="Output" ;;
	in)  KIND=sources; DEFAULT_CMD=get-default-source; SET_CMD=set-default-source
	     STREAMS=source-outputs; MOVE_CMD=move-source-output; PROMPT="Input" ;;
	*)   echo "usage: dwm-audio list|menu|pick out|in" >&2; exit 2 ;;
	esac
}

# Prints "name<TAB>description" per real device (monitor sources excluded).
devices() {
	pactl --format=json list "$KIND" | python3 -c '
import json, sys
for d in json.load(sys.stdin):
    if d["name"].endswith(".monitor"):
        continue
    # Skip devices whose active jack is unplugged; WirePlumber will not route to them.
    avail = {q["name"]: q.get("availability") for q in d.get("ports", [])}.get(d.get("active_port"))
    if avail == "not available":
        continue
    print(d["name"] + "\t" + d["description"])'
}

list_entries() {
	local current name desc
	current="$(pactl "$DEFAULT_CMD")"
	while IFS=$'\t' read -r name desc; do
		if [ "$name" = "$current" ]; then echo "* $desc"; else echo "  $desc"; fi
	done < <(devices)
}

pick() {
	local label="${1#[* ] }" name desc target=""
	label="${label# }"
	while IFS=$'\t' read -r name desc; do
		[ "$desc" = "$label" ] && { target="$name"; break; }
	done < <(devices)
	[ -n "$target" ] || exit 1
	pactl "$SET_CMD" "$target"
	# Move live streams too, otherwise already-playing apps stay on the old device.
	for id in $(pactl list short "$STREAMS" | cut -f1); do
		pactl "$MOVE_CMD" "$id" "$target" 2>/dev/null
	done
}

status() {
	local v pct out m mpct mic
	v="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)"
	pct="$(awk '{printf "%d", $2 * 100 + 0.5}' <<< "$v")"
	if [[ "$v" == *MUTED* ]]; then out="VOL MUTE"; else out="VOL ${pct}%"; fi
	m="$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null)"
	mpct="$(awk '{printf "%d", $2 * 100 + 0.5}' <<< "$m")"
	if [[ "$m" == *MUTED* ]]; then mic="MIC MUTE"; else mic="MIC ${mpct}%"; fi
	echo "${out} ${mic}"
}

case "$1" in
vol)
	case "$2" in
	up)      wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
	         wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "${STEP}%+" ;;
	down)    wpctl set-volume @DEFAULT_AUDIO_SINK@ "${STEP}%-" ;;
	mute)    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
	micmute) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
	micup)   wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0
	         wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ "${STEP}%+" ;;
	micdown) wpctl set-volume @DEFAULT_AUDIO_SOURCE@ "${STEP}%-" ;;
	*)       echo "usage: dwm-audio vol up|down|mute|micmute|micup|micdown" >&2; exit 2 ;;
	esac
	refresh_bar ;;
status) status ;;
list)   kind_setup "$2"; list_entries ;;
pick)   kind_setup "$2"; pick "$3"; refresh_bar ;;
menu)
	kind_setup "$2"
	if [ "$2" = out ]; then other=in; link="-> Input devices"; else other=out; link="-> Output devices"; fi
	choice="$({ list_entries; echo "$link"; } | "${DMENU[@]}" -p "$PROMPT")" || exit 0
	case "$choice" in
	"")      ;;
	"$link") exec "$0" menu "$other" ;;
	*)       pick "$choice"; refresh_bar ;;
	esac ;;
*)
	echo "usage: dwm-audio vol|status|menu|list|pick" >&2; exit 2 ;;
esac
